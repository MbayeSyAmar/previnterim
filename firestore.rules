rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userData() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isAdmin() { return signedIn() && userData().role == 'admin'; }
    function isCandidate() { return signedIn() && userData().role == 'candidate'; }
    function isCompany() { return signedIn() && userData().role == 'company'; }

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role in ['candidate', 'company'];
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status);
      allow delete: if isAdmin();
    }

    match /candidateProfiles/{uid} {
      allow create, read, update: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow delete: if isAdmin();
    }

    match /companies/{uid} {
      allow create, read, update: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow delete: if isAdmin();
    }

    match /missions/{missionId} {
      // Published missions are a public job board: readable without an account.
      // Applying still requires signing in (see /applications below).
      allow read: if isAdmin()
        || resource.data.status == 'published'
        || (isCompany() && resource.data.companyId == request.auth.uid);
      // The pay never goes in the public mission document: see private/terms below.
      allow create: if !('pay' in request.resource.data) && (isAdmin() || (isCompany()
        && userData().status == 'active'
        && request.resource.data.companyId == request.auth.uid
        && request.resource.data.status == 'pending'));
      allow update: if request.resource.data.get('pay', null) == resource.data.get('pay', null)
        && (isAdmin() || (isCompany()
        && resource.data.companyId == request.auth.uid
        && request.resource.data.companyId == request.auth.uid
        && request.resource.data.status == resource.data.status));
      allow delete: if isAdmin() || (isCompany()
        && resource.data.companyId == request.auth.uid);

      // Pay offered by the company: hidden from candidates and from the public board.
      match /private/{docId} {
        allow read: if isAdmin() || (isCompany()
          && get(/databases/$(database)/documents/missions/$(missionId)).data.companyId == request.auth.uid);
        allow create, update: if isAdmin() || (isCompany()
          && getAfter(/databases/$(database)/documents/missions/$(missionId)).data.companyId == request.auth.uid);
        allow delete: if isAdmin();
      }
    }

    match /applications/{applicationId} {
      // Un CV est exige avant toute candidature. Sans lui, l'equipe recoit des
      // dossiers qu'elle ne peut pas qualifier : au 2026-10-25, sur douze
      // profils candidats un seul avait depose un CV, et les sept candidatures
      // existantes venaient toutes de profils sans CV.
      //
      // Le controle passe par un chemin previsible, `candidateDocuments/<uid>_cv`,
      // parce qu'une regle ne peut pas interroger une collection : elle ne sait
      // que lire un document dont elle connait l'adresse. Voir `ID_CV` dans
      // firebase.js, qui ecrit le CV a cette adresse.
      allow create: if isCandidate()
        && request.resource.data.candidateId == request.auth.uid
        && request.resource.data.status == 'pending'
        && exists(/databases/$(database)/documents/candidateDocuments/$(request.auth.uid + '_cv'));
      allow read: if isAdmin() || (isCandidate() && resource.data.candidateId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isCandidate()
        && resource.data.candidateId == request.auth.uid
        && resource.data.status == 'pending');
    }

    match /proposals/{proposalId} {
      allow create, delete: if isAdmin();
      allow read: if isAdmin()
        || (isCompany() && resource.data.companyId == request.auth.uid)
        || (isCandidate() && resource.data.candidateId == request.auth.uid);
      allow update: if isAdmin() || (isCompany()
        && resource.data.companyId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['response', 'updatedAt']));
    }

    match /interviews/{interviewId} {
      allow create, update, delete: if isAdmin();
      allow read: if isAdmin() || (isCandidate() && resource.data.candidateId == request.auth.uid);
    }

    match /candidateDocuments/{documentId} {
      // Lire l'adresse de son propre CV est toujours autorise, meme quand le
      // document n'existe pas encore. Sans cette troisieme branche, la lecture
      // d'un document absent est REFUSEE et non vide : `resource` vaut null,
      // donc `resource.data.candidateId` ne peut pas etre evalue. L'ecran du
      // candidat interrogeant cette adresse a chaque chargement, tout candidat
      // sans CV se voyait refuser le chargement complet de son espace.
      allow read: if isAdmin()
        || (isCandidate() && resource != null && resource.data.candidateId == request.auth.uid)
        || (signedIn() && documentId == request.auth.uid + '_cv');
      allow create: if isAdmin() || (signedIn() && request.auth.uid == request.resource.data.candidateId && request.resource.data.uploadedBy == request.auth.uid);
      // Le CV vit a une adresse fixe pour que la regle des candidatures puisse
      // le verifier, donc en deposer un nouveau est une mise a jour et non une
      // creation. Elle reste limitee a son proprietaire et a son propre CV :
      // l'identifiant doit etre exactement `<uid>_cv`, ce qui interdit de
      // toucher au document de quelqu'un d'autre.
      allow update: if isAdmin()
        || (signedIn()
          && documentId == request.auth.uid + '_cv'
          && request.resource.data.candidateId == request.auth.uid
          && request.resource.data.uploadedBy == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /placements/{placementId} {
      allow read: if isAdmin()
        || (isCandidate() && resource.data.candidateId == request.auth.uid)
        || (isCompany() && resource.data.companyId == request.auth.uid);
      allow create, update, delete: if isAdmin();

      // Pay rate paid to the candidate: never exposed to the company, even though
      // the company can read the placement itself (it needs the bill rate only).
      match /private/{doc} {
        allow read: if isAdmin()
          || (isCandidate() && get(/databases/$(database)/documents/placements/$(placementId)).data.candidateId == request.auth.uid);
        allow write: if isAdmin();
      }
    }

    match /timesheets/{timesheetId} {
      allow read: if isAdmin()
        || (isCandidate() && resource.data.candidateId == request.auth.uid)
        || (isCompany() && resource.data.companyId == request.auth.uid);
      allow create: if isAdmin() || (isCandidate()
        && request.resource.data.candidateId == request.auth.uid
        && request.resource.data.status == 'submitted'
        && get(/databases/$(database)/documents/placements/$(request.resource.data.placementId)).data.candidateId == request.auth.uid);
      allow update: if isAdmin()
        || (isCandidate() && resource.data.candidateId == request.auth.uid
          && resource.data.status in ['submitted', 'disputed']
          && request.resource.data.status == 'submitted'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['days', 'totalHours', 'status', 'companyNote', 'updatedAt']))
        || (isCompany() && resource.data.companyId == request.auth.uid
          && resource.data.status == 'submitted'
          && request.resource.data.status in ['validated', 'disputed']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'companyNote', 'updatedAt']));
      allow delete: if isAdmin() || (isCandidate()
        && resource.data.candidateId == request.auth.uid
        && resource.data.status == 'submitted');
    }

    match /invoices/{invoiceId} {
      allow read: if isAdmin()
        || (isCompany() && resource.data.companyId == request.auth.uid && resource.data.status != 'draft');
      allow create, update, delete: if isAdmin();
    }

    match /candidatePayments/{paymentId} {
      allow read: if isAdmin() || (isCandidate() && resource.data.candidateId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    match /followUps/{followUpId} {
      allow read: if isAdmin()
        || (isCandidate() && resource.data.candidateId == request.auth.uid)
        || (isCompany() && resource.data.companyId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    // Candidate<->company messaging is only allowed once a chat grant exists for
    // that pair. No Cloud Function involved: either side can create/self-heal it
    // (company at accept-time, or either side later when opening Messages), but
    // the rule always re-verifies a matching proposal really exists, really is
    // for that candidate/company pair, and really is accepted.
    match /chatGrants/{grantId} {
      function proposalData() {
        return get(/databases/$(database)/documents/proposals/$(request.resource.data.proposalId)).data;
      }
      allow create: if isAdmin()
        || (grantId == request.resource.data.candidateId + '_' + request.resource.data.companyId
          && proposalData().candidateId == request.resource.data.candidateId
          && proposalData().companyId == request.resource.data.companyId
          && proposalData().response == 'accepted'
          && ((isCompany() && request.resource.data.companyId == request.auth.uid)
            || (isCandidate() && request.resource.data.candidateId == request.auth.uid)));
      allow read: if isAdmin()
        || (signedIn() && (resource.data.candidateId == request.auth.uid || resource.data.companyId == request.auth.uid));
      allow update, delete: if isAdmin();
    }

    match /conversations/{conversationId} {
      function isConvParticipant() {
        return isAdmin() || (signedIn()
          && (resource.data.candidateId == request.auth.uid || resource.data.companyId == request.auth.uid));
      }
      function hasChatGrant(candidateId, companyId) {
        return exists(/databases/$(database)/documents/chatGrants/$(candidateId + '_' + companyId));
      }

      allow read: if isConvParticipant();
      allow create: if isAdmin()
        || (isCandidate() && request.resource.data.type == 'admin-candidate'
          && request.resource.data.candidateId == request.auth.uid)
        || (isCompany() && request.resource.data.type == 'admin-company'
          && request.resource.data.companyId == request.auth.uid)
        || (isCandidate() && request.resource.data.type == 'candidate-company'
          && request.resource.data.candidateId == request.auth.uid
          && hasChatGrant(request.resource.data.candidateId, request.resource.data.companyId))
        || (isCompany() && request.resource.data.type == 'candidate-company'
          && request.resource.data.companyId == request.auth.uid
          && hasChatGrant(request.resource.data.candidateId, request.resource.data.companyId));
      allow update: if isConvParticipant()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageAt', 'unread', 'updatedAt']);
      allow delete: if isAdmin();

      match /messages/{messageId} {
        function isParentParticipant() {
          return isAdmin() || (signedIn() && (
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.candidateId == request.auth.uid
            || get(/databases/$(database)/documents/conversations/$(conversationId)).data.companyId == request.auth.uid
          ));
        }

        allow read: if isParentParticipant();
        allow create: if request.resource.data.senderId == request.auth.uid && isParentParticipant();
        allow update, delete: if false;
      }
    }

    // Public contact form. Anyone can submit, nobody but the admin can read it back.
    // The Brevo emails are sent by the onContactMessage trigger.
    match /contactMessages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'topic', 'subject', 'message', 'uid', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 1 && request.resource.data.name.size() <= 120
        && request.resource.data.email is string && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') && request.resource.data.email.size() <= 200
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 40
        && request.resource.data.topic in ['candidate', 'company', 'other']
        && request.resource.data.subject is string && request.resource.data.subject.size() > 2 && request.resource.data.subject.size() <= 150
        && request.resource.data.message is string && request.resource.data.message.size() >= 10 && request.resource.data.message.size() <= 4000
        && request.resource.data.uid == (request.auth == null ? null : request.auth.uid)
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    // OAuth tokens, temporary states and the mail log are server-only. No client rule is provided.
  }
}
